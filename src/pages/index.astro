---
import Contours from '../components/Contours.astro';
import CourseMap from '../components/CourseMap.astro';
import CourseTimeline from '../components/CourseTimeline.astro';
import GetInTouch from '../components/GetInTouch.astro';
import HomeHero from '../components/HomeHero.astro';
import PostGrid from '../components/PostGrid.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatsBand from '../components/StatsBand.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Page from '../layouts/Page.astro';
import { getStats } from '../lib/courses';

const stats = await getStats();
const headline = [
	{ value: stats.rounds, label: 'Rounds played' },
	{ value: stats.courses, label: 'Courses walked' },
	...(stats.best != null ? [{ value: stats.best, label: 'Best score', accent: true }] : []),
];
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<HomeHero />
	<StatsBand items={headline} />

	<section id="latest" class="scroll-mt-24 py-16 md:py-24">
		<div class="mx-auto max-w-7xl px-5 md:px-8">
			<SectionHeader
				title="Fresh off the eighteenth"
				intro="Write ups, scores and photos from the most recent rounds."
			/>
			<PostGrid limit={7} leadFirst />
		</div>
	</section>

	<section id="map" class="relative isolate scroll-mt-20 overflow-hidden bg-night py-16 text-paper md:py-24">
		<Contours class="text-accent/6" />
		<div class="mx-auto max-w-7xl px-5 md:px-8">
			<SectionHeader
				title="Where I've played"
				link={{ href: '/courses/', label: 'All courses' }}
				dark
			/>
			<CourseMap />
		</div>
	</section>

	<section class="py-16 md:py-24">
		<div class="mx-auto max-w-7xl px-5 md:px-8">
			<SectionHeader title="Every course, year by year" />
			<CourseTimeline />
		</div>
	</section>

	<GetInTouch />
</Page>
