---
import Contours from '../components/Contours.astro';
import CourseMap from '../components/CourseMap.astro';
import CourseTimeline from '../components/CourseTimeline.astro';
import HomeHero from '../components/HomeHero.astro';
import PostGrid from '../components/PostGrid.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatsBand from '../components/StatsBand.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Page from '../layouts/Page.astro';
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<HomeHero />
	<StatsBand />

	<section id="latest" class="scroll-mt-24 py-20 md:py-28">
		<div class="mx-auto max-w-7xl px-5 md:px-8">
			<SectionHeader
				index="01"
				label="Latest rounds"
				title="Fresh off the eighteenth"
				intro="Write ups, scores and photos from the most recent rounds."
				link={{ href: '/blog/', label: 'All rounds' }}
			/>
			<PostGrid limit={7} leadFirst />
		</div>
	</section>

	<section id="map" class="relative isolate scroll-mt-20 overflow-hidden bg-night py-20 text-paper md:py-28">
		<Contours class="text-accent/6" />
		<div class="mx-auto max-w-7xl px-5 md:px-8">
			<SectionHeader
				index="02"
				label="The map"
				title="Where I've played"
				intro="Every course with a pin. Click one to see every round I have played there."
				link={{ href: '/courses/', label: 'All courses' }}
				dark
			/>
			<CourseMap />
		</div>
	</section>

	<section class="py-20 md:py-28">
		<div class="mx-auto max-w-7xl px-5 md:px-8">
			<SectionHeader index="03" label="Course log" title="Every course, year by year" />
			<CourseTimeline />
		</div>
	</section>
</Page>
