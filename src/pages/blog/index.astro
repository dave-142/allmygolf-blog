---
import PageHero from '../../components/PageHero.astro';
import PostGrid from '../../components/PostGrid.astro';
import { SITE_TITLE } from '../../consts';
import Page from '../../layouts/Page.astro';
import { getCourseMap, getPosts, postTile } from '../../lib/courses';

const [posts, courses] = await Promise.all([getPosts(), getCourseMap()]);
const tiles = posts.map((post) => postTile(post, courses));
const years = [...new Set(tiles.map((t) => t.year))];
---

<Page title={`Rounds | ${SITE_TITLE}`} description="Every round, newest first.">
	<PageHero eyebrow={`${posts.length} posts`} title="Every round" intro="Scores, write ups and photos from every round, newest first." />

	<section class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-5 md:px-8">
			{years.length > 1 && (
				<div class="-mx-5 mb-8 overflow-x-auto px-5 md:mx-0 md:px-0" role="group" aria-label="Filter by year">
					<div class="flex w-max gap-2 rounded-full border border-ink/10 bg-white p-1.5 shadow-sm">
						{['All', ...years].map((year, i) => (
							<button
								type="button"
								data-year-filter={year}
								aria-pressed={i === 0 ? 'true' : 'false'}
								class="rounded-full px-5 py-2 text-sm font-semibold text-ink/60 transition-colors hover:text-ink aria-pressed:bg-forest aria-pressed:text-accent"
							>
								{year}
							</button>
						))}
					</div>
				</div>
			)}
			<PostGrid tiles={tiles} leadFirst />
		</div>
	</section>
</Page>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-year-filter]');
	const cards = document.querySelectorAll<HTMLElement>('[data-post-grid] > [data-year]');

	buttons.forEach((button) =>
		button.addEventListener('click', () => {
			const year = button.dataset.yearFilter;
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
			cards.forEach((card) => {
				card.hidden = year !== 'All' && card.dataset.year !== year;
				card.classList.add('is-visible');
			});
		}),
	);
</script>
