---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Stars from '../../components/Stars.astro';
import StatsBand, { type StatItem } from '../../components/StatsBand.astro';
import { SITE_TITLE } from '../../consts';
import Page from '../../layouts/Page.astro';
import { bestScore, coverPhoto, getRounds, latestPhoto, postHref } from '../../lib/courses';

export async function getStaticPaths() {
	const courses = await getCollection('courses');
	return courses.map((course) => ({
		params: { id: course.id },
		props: course,
	}));
}
type Props = CollectionEntry<'courses'>;

const course = Astro.props;
const { par, yardage } = course.data;
// Newest first
const rounds = (await getRounds()).filter((r) => r.data.course?.id === course.id);
const photo = latestPhoto(rounds);

const scores = rounds.map((r) => r.data.score).filter((s): s is number => s != null);
const best = bestScore(rounds);
const average = scores.length > 0 ? scores.reduce((sum, s) => sum + s, 0) / scores.length : undefined;
const fullDate = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
// +11, E or -2. Blank without a par or a score
const versusPar = (score?: number) => {
	if (!par || score == null) return '';
	const diff = score - par;
	return diff === 0 ? 'E' : diff > 0 ? `+${diff}` : `${diff}`;
};

// The stats band under the hero: my record here, then the course
const stats: StatItem[] = [
	...(rounds.length > 0 ? [{ label: 'Rounds', value: rounds.length }] : []),
	...(best != null ? [{ label: 'Best', value: best, extra: versusPar(best), accent: true }] : []),
	...(average != null && scores.length > 1 ? [{ label: 'Average', value: average.toFixed(1) }] : []),
	...(par ? [{ label: 'Par', value: par }] : []),
	...(yardage ? [{ label: 'Yards', value: yardage.toLocaleString('en-GB') }] : []),
];

// Date, score, rating, photo. Rating moves under the date on small screens
const columns = 'grid grid-cols-[minmax(0,1fr)_auto_2.75rem] items-center gap-x-4 sm:grid-cols-[minmax(0,1fr)_6rem_7.5rem_2.75rem] sm:gap-x-6';
---

<Page title={`${course.data.name} | ${SITE_TITLE}`} description={`My rounds at ${course.data.name}.`} image={photo}>
	<PageHero title={course.data.name} image={photo} tall={!!photo} />
	<StatsBand items={stats} />

	<section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
		<SectionHeader
			title="Rounds"
			intro={rounds.length > 0 ? 'Every round I have played here, newest first.' : 'Not played yet.'}
		/>

		{rounds.length > 0 && (
			<div
				data-reveal
				class="overflow-hidden rounded-card bg-white shadow-card ring-1 ring-ink/5"
			>
				<div aria-hidden="true" class:list={[columns, 'bg-night-800 px-5 py-4 caps-label text-mist md:px-8']}>
					<span>Date</span>
					<span>Score</span>
					<span class="hidden sm:block">Rating</span>
					<span></span>
				</div>
				<ol>
					{rounds.map((round) => {
						const { pubDate, score, rating, verdict } = round.data;
						const thumb = coverPhoto(round);
						const isBest = best != null && score === best;
						return (
							<li
								class:list={[
									'group relative border-b border-ink/5 px-5 py-4 transition-colors last:border-0 md:px-8',
									// The best round keeps its highlight. Other rows get a neutral hover
									isBest ? 'bg-accent/10' : 'hover:bg-paper',
								]}
							>
								<div class={columns}>
									<div>
										<a href={postHref(round.id)} class="text-lg font-semibold after:absolute after:inset-0 group-hover:underline">
											{fullDate(pubDate)}
										</a>
										{rating && <Stars rating={rating} class="mt-1 text-sm text-accent-dark sm:hidden" />}
									</div>
									<p class="whitespace-nowrap tabular-nums">
										<span class="sr-only">Score: </span>
										{score != null ? (
											<>
												<span class="text-lg font-semibold">{score}</span>
												{versusPar(score) && <span class="ml-1.5 text-ink/50">{versusPar(score)}</span>}
											</>
										) : (
											<span class="font-medium text-ink/55">No score</span>
										)}
									</p>
									<div class="hidden sm:block">{rating && <Stars rating={rating} class="text-accent-dark" />}</div>
									<div>
										{thumb && (
											<span class="block size-11 overflow-hidden rounded-lg bg-night-800">
												<Image src={thumb} alt="" widths={[96]} sizes="44px" quality={70} class="h-full w-full object-cover" />
												<span class="sr-only">Has photos</span>
											</span>
										)}
									</div>
								</div>
								{verdict && <p class="mt-2 text-lg text-ink/70">&ldquo;{verdict}&rdquo;</p>}
							</li>
						);
					})}
				</ol>
			</div>
		)}
	</section>
</Page>
