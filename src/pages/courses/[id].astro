---
import { type CollectionEntry, getCollection } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import { SITE_TITLE } from '../../consts';
import Page from '../../layouts/Page.astro';
import { courseLocation, coverPhoto, getRounds } from '../../lib/courses';

export async function getStaticPaths() {
	const courses = await getCollection('courses');
	return courses.map((course) => ({
		params: { id: course.id },
		props: course,
	}));
}
type Props = CollectionEntry<'courses'>;

const course = Astro.props;
const latest = (await getRounds()).find((r) => r.data.course?.id === course.id);
const photo = latest && coverPhoto(latest);
const location = courseLocation(course);

// Small facts shown as chips under the name
const facts = [
	course.data.par != null && `Par ${course.data.par}`,
	course.data.holes != null && `${course.data.holes} holes`,
	course.data.yardage != null && `${course.data.yardage.toLocaleString('en-GB')} yards`,
].filter(Boolean);
---

<Page title={`${course.data.name} | ${SITE_TITLE}`} description={`My rounds at ${course.data.name}.`} image={photo}>
	<PageHero eyebrow={location || 'Course'} title={course.data.name} image={photo} tall={!!photo}>
		{facts.length > 0 && (
			<ul class="mt-8 flex flex-wrap gap-2">
				{facts.map((fact) => (
					<li class="rounded-full border border-paper/20 bg-paper/10 px-4 py-2 text-sm font-medium backdrop-blur">{fact}</li>
				))}
			</ul>
		)}
	</PageHero>
</Page>
