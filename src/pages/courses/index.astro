---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostGrid, { type Tile } from '../../components/PostGrid.astro';
import { SITE_TITLE } from '../../consts';
import { courseHref, courseLocation, coverPhoto, getCourseSummaries } from '../../lib/courses';

const summaries = await getCourseSummaries();

const tiles: Tile[] = summaries.map(({ course, rounds, latest }) => ({
	href: courseHref(course.id),
	title: course.data.name,
	eyebrow: rounds.length === 1 ? 'Played once' : rounds.length > 1 ? `Played ${rounds.length} times` : 'Not played yet',
	description: courseLocation(course),
	photo: latest && coverPhoto(latest),
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Courses | ${SITE_TITLE}`} description="Every course I have played." />
	</head>
	<body>
		<Header />
		<main>
			<div class="container mx-auto px-6 py-8 md:py-12">
				<h1 class="pb-6 text-3xl font-bold md:pb-8 md:text-4xl">Courses</h1>
				<PostGrid tiles={tiles} />
			</div>
		</main>
		<Footer />
	</body>
</html>
