---
import PageHero from '../../components/PageHero.astro';
import PostGrid from '../../components/PostGrid.astro';
import { SITE_TITLE } from '../../consts';
import Page from '../../layouts/Page.astro';
import { type Tile, courseHref, courseLocation, coverPhoto, getCourseSummaries, getStats } from '../../lib/courses';

const [summaries, stats] = await Promise.all([getCourseSummaries(), getStats()]);

const tiles: Tile[] = summaries.map(({ course, rounds, latest, best }) => ({
	href: courseHref(course.id),
	title: course.data.name,
	eyebrow: rounds.length === 1 ? 'Played once' : rounds.length > 1 ? `Played ${rounds.length} times` : 'Not played yet',
	description: courseLocation(course),
	photo: latest && coverPhoto(latest),
	badge: best,
	badgeLabel: best != null ? 'Best' : undefined,
}));
---

<Page title={`Courses | ${SITE_TITLE}`} description="Every course I have played.">
	<PageHero
		eyebrow={`${stats.courses} courses, ${stats.countries} ${stats.countries === 1 ? 'country' : 'countries'}`}
		title="The courses"
		intro="Every course I have walked, with my best score there. Most recent first."
	/>

	<section class="py-12 md:py-20">
		<div class="mx-auto max-w-7xl px-5 md:px-8">
			<PostGrid tiles={tiles} />
		</div>
	</section>
</Page>
