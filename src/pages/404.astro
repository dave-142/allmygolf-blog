---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import GolferShadingEyes from '../assets/illustrations/golfer-shading-eyes.svg';
import Contours from '../components/Contours.astro';
import { SITE_TITLE } from '../consts';
import Page from '../layouts/Page.astro';
---

<Page title={`Lost ball | ${SITE_TITLE}`} description="This page is out of bounds.">
	<section class="relative isolate flex min-h-[86svh] overflow-hidden bg-night text-paper">
		<Contours class="text-accent/10" />
		<div class="mx-auto grid w-full max-w-7xl items-center gap-10 px-5 pt-36 pb-16 md:grid-cols-[1fr_auto] md:px-8">
			<div>
				<p class="mb-5 inline-flex rounded-full border border-paper/20 bg-paper/10 px-3 py-1 caps-label text-mist">
					404
				</p>
				<h1 class="text-5xl leading-[0.9] font-semibold tracking-tighter text-balance sm:text-6xl md:text-8xl">Lost ball.</h1>
				<p class="mt-6 max-w-xl text-lg text-paper/75 md:text-xl">
					This page is out of bounds. Take a drop and try one of these instead.
				</p>
				<div class="mt-10 flex flex-wrap gap-3">
					<a
						href="/blog/"
						class="group inline-flex items-center gap-2 rounded-full bg-accent px-5 py-3 text-sm font-semibold text-night transition-transform hover:-translate-y-0.5"
					>
						All rounds
						<ArrowUpRight class="size-4" aria-hidden="true" />
					</a>
					<a
						href="/courses/"
						class="inline-flex items-center gap-2 rounded-full border border-paper/20 px-5 py-3 text-sm font-semibold transition-colors hover:border-accent hover:bg-accent hover:text-night"
					>
						All courses
					</a>
					<a
						href="/"
						class="inline-flex items-center gap-2 rounded-full border border-paper/20 px-5 py-3 text-sm font-semibold transition-colors hover:border-accent hover:bg-accent hover:text-night"
					>
						Home
					</a>
				</div>
			</div>
			<GolferShadingEyes class="mx-auto h-56 w-auto text-paper md:h-96" />
		</div>
	</section>
</Page>
