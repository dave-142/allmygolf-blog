---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
	image: ImageMetadata;
	title?: string;
	subtitle?: string;
	href?: string;
}

interface Props {
	items: Item[];
	class?: string;
}

const { items, class: className = '' } = Astro.props;
const shown = items.slice(0, 5);
---

{shown.length > 0 && (
	<div data-expanding-gallery class={`flex h-[420px] gap-3 ${className}`}>
		{shown.map((item, i) => {
			const Tag = item.href ? 'a' : 'div';
			return (
				<Tag
					href={item.href}
					data-panel
					data-active={i === 0 ? '' : undefined}
					tabindex={item.href ? undefined : 0}
					class="group/panel relative min-w-12 flex-1 overflow-hidden rounded-2xl grayscale transition-all duration-500 ease-out data-active:flex-[4] data-active:grayscale-0"
				>
					<Image
						src={item.image}
						alt={item.title ?? ''}
						width={1200}
						class="absolute inset-0 h-full w-full object-cover object-center"
					/>
					{item.title && (
						<div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/60 to-transparent p-5 text-white opacity-0 transition-opacity duration-300 group-data-active/panel:opacity-100">
							<p class="font-semibold">{item.title}</p>
							{item.subtitle && <p class="text-sm text-white/80">{item.subtitle}</p>}
						</div>
					)}
				</Tag>
			);
		})}
	</div>
)}

<script>
	document.querySelectorAll('[data-expanding-gallery]').forEach((gallery) => {
		const panels = gallery.querySelectorAll<HTMLElement>('[data-panel]');

		const activate = (panel: HTMLElement) => {
			panels.forEach((p) => p.toggleAttribute('data-active', p === panel));
		};

		panels.forEach((panel) => {
			panel.addEventListener('mouseenter', () => activate(panel));
			panel.addEventListener('focus', () => activate(panel));
			// On touch screens the first tap widens the panel, the second opens the link
			panel.addEventListener('click', (event) => {
				if (!panel.hasAttribute('data-active')) {
					event.preventDefault();
					activate(panel);
				}
			});
		});
	});
</script>