---
import { Image } from 'astro:assets';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import FormattedDate from './FormattedDate.astro';
import { type Tile, getCourseMap, getPosts, postTile } from '../lib/courses';

interface Props {
	// Defaults to the most recent posts
	tiles?: Tile[];
	limit?: number;
	// Makes the first card a large 2 by 2 tile on wide screens
	leadFirst?: boolean;
	// Columns on wide screens
	columns?: 3 | 4;
}

const { limit = 12, leadFirst = false, columns = 4 } = Astro.props;

const tiles: Tile[] =
	Astro.props.tiles ??
	(await Promise.all([getPosts(), getCourseMap()]).then(([posts, courses]) =>
		posts.slice(0, limit).map((post) => postTile(post, courses)),
	));
---

<div
	data-post-grid
	class:list={[
		'grid grid-flow-dense auto-rows-[22rem] grid-cols-1 gap-4 sm:grid-cols-2 lg:auto-rows-[20rem]',
		columns === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4',
	]}
>
	{tiles.map((tile, i) => {
		const lead = leadFirst && i === 0;
		const wide = !lead && tile.featured;
		return (
			<a
				href={tile.href}
				data-reveal
				data-year={tile.year}
				style={`--reveal-delay: ${(i % 4) * 70}ms`}
				class:list={[
					'group relative isolate block overflow-hidden rounded-[1.75rem] bg-night-800 text-white shadow-[0_20px_50px_-30px_rgb(28_35_38/0.6)] transition-shadow duration-500 hover:shadow-[0_30px_70px_-25px_rgb(28_35_38/0.7)]',
					lead && 'sm:col-span-2 lg:row-span-2',
					wide && 'sm:col-span-2',
				]}
			>
				{tile.photo ? (
					<Image
						src={tile.photo}
						alt=""
						widths={lead || wide ? [1400, 2000] : [800, 1400]}
						sizes={lead || wide ? '(min-width: 640px) 50vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
						class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-110"
					/>
				) : (
					<div class="absolute inset-0 -z-10 bg-linear-to-br from-night-700 to-night"></div>
				)}
				<div class="absolute inset-0 -z-10 bg-linear-to-t from-night/95 via-night/35 to-transparent transition-opacity duration-500 group-hover:from-night"></div>

				{tile.badge != null && (
					<div class="absolute top-4 right-4 flex flex-col items-center rounded-2xl bg-accent px-3 py-2 text-night shadow-lg">
						<span class="text-2xl leading-none font-bold tabular-nums">{tile.badge}</span>
						{tile.badgeLabel && <span class="mt-0.5 text-[0.6rem] font-semibold tracking-widest uppercase">{tile.badgeLabel}</span>}
					</div>
				)}

				<div class="absolute top-4 left-4 grid size-10 translate-y-1 place-items-center rounded-full bg-white/15 opacity-0 backdrop-blur-md transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
					<ArrowUpRight class="size-5" aria-hidden="true" />
				</div>

				<div class="flex h-full flex-col justify-end p-6">
					<p class="mb-2 flex flex-wrap items-center gap-x-2 text-xs font-semibold tracking-wider text-mist uppercase">
						{tile.date && <FormattedDate date={tile.date} />}
						{tile.date && tile.eyebrow && <span aria-hidden="true" class="size-1 rounded-full bg-accent/60"></span>}
						{tile.eyebrow && <span class="text-white/80">{tile.eyebrow}</span>}
					</p>
					<h3
						class:list={[
							'leading-[1.05] font-semibold tracking-tight text-balance',
							lead ? 'text-3xl md:text-5xl' : wide ? 'text-2xl md:text-3xl' : 'text-xl md:text-2xl',
						]}
					>
						{tile.title}
					</h3>
					{tile.description && (
						<p
							class:list={[
								'mt-2 text-white/75',
								lead ? 'line-clamp-3 max-w-xl text-base md:text-lg' : 'line-clamp-2 text-sm',
							]}
						>
							{tile.description}
						</p>
					)}
				</div>
			</a>
		);
	})}
</div>
