---
import GolferCelebrating from '../assets/illustrations/golfer-celebrating.svg';
import FormattedDate from './FormattedDate.astro';
import Stars from './Stars.astro';

// Stats for course and round pages. By default a white strip of cards that overlaps the bottom of the page hero.
// Slim is a single row between thin rules, used inside the reading column on round pages.
export interface Stat {
	label: string;
	value?: string | number;
	// Smaller, lighter text after the value, e.g. "+9" after a score
	extra?: string;
	date?: Date;
	rating?: number;
	// Marks a course best score with the celebrating golfer
	best?: boolean;
}

interface Props {
	stats: Stat[];
	slim?: boolean;
}

const { stats, slim = false } = Astro.props;
---

{stats.length > 0 && slim && (
	<dl data-reveal class="flex flex-wrap gap-x-10 gap-y-5 border-y border-ink/10 py-5">
		{stats.map((stat) => (
			<div>
				<dt class="text-[0.65rem] font-semibold tracking-[0.2em] text-ink/40 uppercase">{stat.label}</dt>
				<dd class="mt-1 flex items-center gap-2 text-lg leading-tight font-semibold tabular-nums">
					{stat.date ? (
						<FormattedDate date={stat.date} />
					) : stat.rating != null ? (
						<Stars rating={stat.rating} class="text-base text-slate" />
					) : (
						<span>
							{stat.value}
							{stat.extra && <span class="ml-1 font-normal text-ink/50">{stat.extra}</span>}
						</span>
					)}
					{stat.best && (
						<span class="rounded-full bg-accent px-2 py-0.5 text-[0.6rem] font-semibold tracking-wider text-night uppercase">Course best</span>
					)}
				</dd>
			</div>
		))}
	</dl>
)}

{stats.length > 0 && !slim && (
	<div class="mx-auto -mt-10 max-w-5xl px-5 md:-mt-14 md:px-8">
		<dl
			data-reveal
			class="grid grid-cols-2 gap-px overflow-hidden rounded-[1.75rem] bg-ink/10 shadow-[0_30px_60px_-30px_rgb(28_35_38/0.45)] ring-1 ring-ink/5 md:grid-flow-col md:auto-cols-fr md:grid-cols-none"
		>
			{stats.map((stat, i) => (
				<div
					class:list={[
						'flex flex-col justify-between gap-2 bg-white p-5 md:p-6',
						i === 0 && stats.length % 2 === 1 && 'col-span-2 md:col-span-1',
					]}
				>
					<dt class="text-[0.65rem] font-semibold tracking-[0.2em] text-ink/40 uppercase">{stat.label}</dt>
					<dd class:list={[stat.date || stat.rating != null ? 'text-lg leading-tight font-semibold' : 'text-4xl font-extralight tracking-tighter tabular-nums']}>
						{stat.date ? (
							<FormattedDate date={stat.date} />
						) : stat.rating != null ? (
							<Stars rating={stat.rating} class="text-xl text-slate" />
						) : (
							<span class="flex items-end justify-between gap-3">
								<span>
									{stat.value}
									{stat.extra && <span class="ml-1 text-xl text-ink/50">{stat.extra}</span>}
								</span>
								{stat.best && <GolferCelebrating class="-mb-1 h-14 w-auto text-ink" />}
							</span>
						)}
					</dd>
					{stat.best && <p class="-mt-1 text-[0.65rem] font-semibold tracking-[0.2em] text-accent-dark uppercase">Course best</p>}
				</div>
			))}
		</dl>
	</div>
)}
