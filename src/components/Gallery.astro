---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	photos: { image: ImageMetadata; caption?: string }[];
}

const { photos } = Astro.props;

// The first photo is always the large one
const main = photos[0];

// Smaller photos only when there are 3 or 4 in total.
// With 2, the second photo is ignored.
const rest = photos.length >= 3 ? photos.slice(1, 4) : [];

// Written out in full so Tailwind can see each class
const restCols: Record<number, string> = {
	2: 'grid-cols-2',
	3: 'grid-cols-3',
};
---

{main && (
	<div>
		<figure>
			<Image
				src={main.image}
				alt={main.caption ?? ''}
				width={1600}
				loading="eager"
				class="aspect-video w-full rounded-md object-cover"
			/>
			{main.caption && (
				<figcaption class="mt-3 text-sm italic text-neutral-500">{main.caption}</figcaption>
			)}
		</figure>

		{rest.length > 0 && (
			<div class={`mt-4 grid gap-4 ${restCols[rest.length]}`}>
				{rest.map((photo) => (
					<Image
						src={photo.image}
						alt={photo.caption ?? ''}
						width={600}
						class="aspect-16/10 w-full rounded-md object-cover"
					/>
				))}
			</div>
		)}
	</div>
)}