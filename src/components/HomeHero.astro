---
import { Image } from 'astro:assets';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import FormattedDate from './FormattedDate.astro';
import { coverPhoto, getCourseMap, getRounds, postHref } from '../lib/courses';

// Full screen photo from the latest round with photos, with the tagline and a card for that round
const [rounds, courses] = await Promise.all([getRounds(), getCourseMap()]);
const latest = rounds.find((round) => coverPhoto(round)) ?? rounds[0];
const course = latest?.data.course && courses.get(latest.data.course.id);
const photo = latest && coverPhoto(latest);
---

<section class="relative isolate flex min-h-svh overflow-hidden bg-night text-paper">
	{photo && (
		<Image
			src={photo}
			alt=""
			widths={[800, 1600]}
			quality={70}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			class="absolute inset-0 -z-20 h-full w-full animate-kenburns object-cover"
		/>
	)}
	<div class="absolute inset-0 -z-10 bg-linear-to-t from-night via-night/40 to-night/50"></div>
	<div class="absolute inset-0 -z-10 bg-linear-to-r from-night/70 to-transparent"></div>

	<div class="mx-auto mt-auto grid w-full max-w-7xl gap-10 px-5 pt-36 pb-10 md:px-8 md:pb-20 lg:grid-cols-[1fr_21rem] lg:items-end lg:gap-14">
		<div>
			<h1 class="text-[clamp(2.9rem,6.4vw,6.25rem)] leading-[0.92] font-semibold tracking-tighter text-balance">
				<span class="block">Just my golf, and the moments worth keeping.</span>
			</h1>
		</div>

		{latest && (
			<a
				href={postHref(latest.id)}
				class="group block rounded-card border border-paper/15 bg-night/40 p-5 backdrop-blur-xl transition-colors hover:border-accent/60 hover:bg-night/60"
			>
				<div class="flex items-center justify-between">
					<span class="caps-label text-mist">Latest round</span>
					<ArrowUpRight class="size-5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
				</div>
				<p class="mt-4 text-2xl leading-tight font-semibold tracking-tight text-balance">{latest.data.title}</p>
				<div class="mt-5 flex items-end justify-between gap-4 border-t border-paper/15 pt-4">
					<div class="text-sm text-paper/70">
						{course && <p class="font-medium text-paper">{course.data.name}</p>}
						<FormattedDate date={latest.data.pubDate} />
					</div>
					{latest.data.score != null && (
						<p class="text-right">
							<span class="block text-4xl leading-none font-semibold tracking-tight text-accent tabular-nums">{latest.data.score}</span>
							<span class="mt-2 block caps-label text-mist">Score</span>
						</p>
					)}
				</div>
			</a>
		)}
	</div>
</section>
