---

import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import Gallery from '../components/Gallery.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latest = posts[0];

const photos = latest.data.gallery.slice(0, 4);

import ArrowRight from '@lucide/astro/icons/arrow-right';

---

<div class="w-full border-b border-olive-300 bg-olive-100">
	<div class="container mx-auto max-w-7xl px-6 py-12">
		<div class="grid grid-cols-1 gap-10 lg:grid-cols-[2fr_3fr] lg:gap-16">
			<div>
				<p>Latest round<span class="text-sm font-bold text-olive-600"> - <FormattedDate date={latest.data.pubDate} /></span></p>
				<h1 class="mt-2 mb-6 text-4xl leading-tight font-bold tracking-tight text-balance md:text-5xl xl:text-6xl">{latest.data.title}</h1>
				<p class="text-lg">{latest.data.description}</p>

				<div class="pt-16">
					<a href={`/blog/${latest.id}/`} class="inline-flex items-center gap-3 rounded-md bg-forest px-7 py-4 text-lg font-medium text-white bg-[#1c4530]">
						Read the Report
						<ArrowRight class="size-5" aria-hidden="true" />
					</a>
				</div>

			</div>
			<div>
				<Gallery photos={photos} />
			</div>
			
		</div>
	</div>
</div>
