---
// Decorative topographic lines, like the contours on a course planner. Colour comes from the text colour.
interface Props {
	class?: string;
}
const { class: className } = Astro.props;

const rings = Array.from({ length: 14 }, (_, i) => i);
---

<svg
	aria-hidden="true"
	class:list={['pointer-events-none absolute inset-0 -z-10 h-full w-full', className]}
	viewBox="0 0 1200 800"
	preserveAspectRatio="xMidYMid slice"
	fill="none"
	stroke="currentColor"
	stroke-width="1.2"
>
	<g transform="translate(980 180)">
		{rings.map((i) => (
			<path
				d={`M ${-60 - i * 38} 0 C ${-60 - i * 38} ${-50 - i * 30}, ${40 + i * 30} ${-70 - i * 34}, ${70 + i * 36} ${-10 - i * 4} S ${30 + i * 26} ${70 + i * 36}, ${-20 - i * 20} ${55 + i * 30} S ${-60 - i * 38} ${30 + i * 12}, ${-60 - i * 38} 0 Z`}
			/>
		))}
	</g>
	<g transform="translate(160 720) rotate(-18)">
		{rings.slice(0, 10).map((i) => (
			<ellipse rx={50 + i * 34} ry={28 + i * 20} />
		))}
	</g>
</svg>
