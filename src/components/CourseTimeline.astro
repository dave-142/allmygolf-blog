---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { type Round, bestScore, courseHref, getRounds, latestPhoto } from '../lib/courses';

const [rounds, courses] = await Promise.all([getRounds(), getCollection('courses')]);
const courseById = new Map(courses.map((course) => [course.id, course]));

// Year (newest first) -> course id -> that year's rounds there (newest first)
const years = new Map<number, Map<string, Round[]>>();
for (const round of rounds) {
	const year = round.data.pubDate.getFullYear();
	const id = round.data.course!.id;
	const byCourse = years.get(year) ?? new Map<string, Round[]>();
	byCourse.set(id, [...(byCourse.get(id) ?? []), round]);
	years.set(year, byCourse);
}

const formatMonth = (date: Date) => date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<div class="relative">
	{[...years].map(([year, byCourse]) => (
		<section class="relative grid grid-cols-1 gap-6 border-t border-ink/10 py-10 md:grid-cols-[14rem_1fr] md:gap-12 md:py-16">
			<div class="md:sticky md:top-28 md:self-start">
				<p class="text-7xl leading-none font-extralight tracking-tighter text-night-800 tabular-nums md:text-8xl">{year}</p>
				<p class="mt-3 inline-flex items-center gap-2 rounded-full bg-night-800 px-3 py-1 text-xs font-semibold text-mist">
					{byCourse.size} {byCourse.size === 1 ? 'course' : 'courses'}
				</p>
			</div>

			<ol class="grid gap-4">
				{[...byCourse].map(([id, yearRounds], i) => {
					const course = courseById.get(id);
					if (!course) return null;
					const latest = yearRounds[0];
					const photo = latestPhoto(yearRounds);
					const best = bestScore(yearRounds);
					return (
						<li data-reveal style={`--reveal-delay: ${i * 80}ms`}>
							<a
								href={courseHref(id)}
								class="group grid grid-cols-1 overflow-hidden rounded-[1.75rem] bg-white shadow-[0_1px_0_rgb(0_0_0/0.04),0_20px_40px_-30px_rgb(28_35_38/0.35)] ring-1 ring-ink/5 transition-all duration-500 hover:-translate-y-1 hover:shadow-[0_30px_60px_-30px_rgb(28_35_38/0.45)] sm:grid-cols-[15rem_1fr]"
							>
								<div class="relative aspect-16/10 overflow-hidden bg-night-800 sm:aspect-auto sm:min-h-52">
									{photo && (
										<Image
											src={photo}
											alt=""
											widths={[700, 1400]}
											quality={70}
											sizes="(min-width: 640px) 240px, 100vw"
											class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-110"
										/>
									)}
								</div>

								<div class="flex flex-col p-5 md:p-7">
									<div class="flex items-start justify-between gap-4">
										<div>
											<p class="text-xs font-semibold tracking-wider text-slate uppercase">
												{formatMonth(latest.data.pubDate)}
											</p>
											<h3 class="mt-1.5 text-2xl leading-tight font-semibold tracking-tight text-balance md:text-3xl">
												{course.data.name}
											</h3>
										</div>
										<span class="grid size-10 shrink-0 place-items-center rounded-full border border-ink/10 transition-colors group-hover:border-night-800 group-hover:bg-night-800 group-hover:text-accent">
											<ArrowUpRight class="size-4" aria-hidden="true" />
										</span>
									</div>

									{latest.data.verdict && (
										<p class="mt-3 text-lg text-ink/60 italic">"{latest.data.verdict}"</p>
									)}

									<dl class="mt-auto flex gap-8 border-t border-ink/10 pt-4 text-sm md:mt-6">
										<div>
											<dt class="text-[0.65rem] font-semibold tracking-widest text-ink/40 uppercase">Rounds</dt>
											<dd class="text-2xl font-semibold tabular-nums">{yearRounds.length}</dd>
										</div>
										{best != null && (
											<div>
												<dt class="text-[0.65rem] font-semibold tracking-widest text-ink/40 uppercase">Best</dt>
												<dd class="text-2xl font-semibold tabular-nums">{best}</dd>
											</div>
										)}
										{course.data.par != null && (
											<div>
												<dt class="text-[0.65rem] font-semibold tracking-widest text-ink/40 uppercase">Par</dt>
												<dd class="text-2xl font-semibold tabular-nums">{course.data.par}</dd>
											</div>
										)}
									</dl>
								</div>
							</a>
						</li>
					);
				})}
			</ol>
		</section>
	))}
</div>
