---
import { getStats } from '../lib/courses';

// Headline numbers, styled like the totals row on a scorecard
const stats = await getStats();

const items = [
	{ value: stats.rounds, label: 'Rounds played' },
	{ value: stats.courses, label: 'Courses walked' },
	{ value: stats.best, label: 'Best score' },
].filter((item) => item.value != null);
---

<section class="bg-night-800 text-paper">
	<dl class="mx-auto grid max-w-7xl grid-cols-3">
		{items.map((item, i) => (
			<div
				data-reveal
				style={`--reveal-delay: ${i * 90}ms`}
				class:list={[
					// Reversed so the number shows first; justify-end packs it to the top so numbers line up when labels wrap
					'flex flex-col-reverse justify-end gap-2 border-paper/10 px-4 py-10 sm:px-5 md:px-8 md:py-14',
					i < items.length - 1 && 'border-r',
				]}
			>
				<dt class="text-xs font-semibold tracking-[0.2em] text-paper/60 uppercase">{item.label}</dt>
				<dd class="text-6xl leading-none font-extralight tracking-tighter text-accent tabular-nums md:text-8xl" data-count={item.value}>
					{item.value}
				</dd>
			</div>
		))}
	</dl>
</section>
