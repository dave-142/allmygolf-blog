---
import BrandLogo from '../assets/brand/allmygolf-logo.svg';

const links = [
	{ href: '/blog/', label: 'Rounds' },
	{ href: '/courses/', label: 'Courses' },
	{ href: '/#map', label: 'Map' },
];

const current = Astro.url.pathname;
const isActive = (href: string) => !href.includes('#') && current.startsWith(href);
---

<!--
	Sits over the dark hero at the top of every page, then turns solid once you scroll.
	data-scrolled and data-open are set by the script below.
-->
<header data-site-header class="group fixed inset-x-0 top-0 z-50 text-white transition-colors duration-300 data-scrolled:text-ink data-open:text-white">
	<div
		class="absolute inset-0 -z-10 border-b border-transparent transition-all duration-300 group-data-scrolled:border-ink/5 group-data-scrolled:bg-paper/80 group-data-scrolled:shadow-[0_8px_30px_-12px_rgb(0_0_0/0.15)] group-data-scrolled:backdrop-blur-xl group-data-open:bg-night!"
	>
	</div>
	<div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 md:px-8 md:py-5">
		<a href="/" class="flex items-center">
			{/* The logo file is drawn in black. Forcing its fill to the text colour lets it turn from white to dark on scroll like the rest of the header */}
			<BrandLogo aria-hidden="true" class="h-11 w-auto md:h-12 [&_path]:fill-current!" />
			<span class="sr-only">All My Golf</span>
		</a>

		<nav aria-label="Main" class="hidden md:block">
			<ul class="flex items-center gap-1 rounded-full border border-white/15 bg-white/5 p-1 text-sm font-medium backdrop-blur-md transition-colors group-data-scrolled:border-ink/10 group-data-scrolled:bg-white/60">
				{links.map((link) => (
					<li>
						<a
							href={link.href}
							aria-current={isActive(link.href) ? 'page' : undefined}
							class="block rounded-full px-4 py-2 transition-colors hover:bg-white/15 group-data-scrolled:hover:bg-ink/5 aria-[current=page]:bg-accent! aria-[current=page]:text-night"
						>
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<button
			type="button"
			data-menu-button
			aria-expanded="false"
			aria-controls="mobile-menu"
			class="relative grid size-11 place-items-center rounded-full border border-current/20 md:hidden"
		>
			<span class="sr-only">Menu</span>
			<span aria-hidden="true" class="absolute h-0.5 w-5 -translate-y-1 rounded-full bg-current transition-transform duration-300 group-data-open:translate-y-0 group-data-open:rotate-45"></span>
			<span aria-hidden="true" class="absolute h-0.5 w-5 translate-y-1 rounded-full bg-current transition-transform duration-300 group-data-open:translate-y-0 group-data-open:-rotate-45"></span>
		</button>
	</div>

	<!-- Mobile menu -->
	<nav
		id="mobile-menu"
		aria-label="Main"
		class="invisible fixed inset-x-0 top-19 bottom-0 bg-night px-5 pt-6 pb-10 opacity-0 transition-all duration-300 group-data-open:visible group-data-open:opacity-100 md:hidden"
	>
		<ul class="flex flex-col gap-1">
			{links.map((link, i) => (
				<li
					class="translate-y-4 opacity-0 transition-all duration-500 group-data-open:translate-y-0 group-data-open:opacity-100"
					style={`transition-delay: ${80 + i * 60}ms`}
				>
					<a
						href={link.href}
						aria-current={isActive(link.href) ? 'page' : undefined}
						class="flex items-center justify-between border-b border-white/10 py-5 text-4xl font-semibold tracking-tight aria-[current=page]:text-accent"
					>
						{link.label}
						<span aria-hidden="true" class="text-2xl text-accent">&rarr;</span>
					</a>
				</li>
			))}
		</ul>
		<p class="mt-10 text-sm text-white/50">Not a review site. Just my golf.</p>
	</nav>
</header>

<script>
	const header = document.querySelector<HTMLElement>('[data-site-header]');
	const button = header?.querySelector<HTMLButtonElement>('[data-menu-button]');

	if (header && button) {
		const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 40);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		const setOpen = (open: boolean) => {
			header.toggleAttribute('data-open', open);
			button.setAttribute('aria-expanded', String(open));
			document.documentElement.style.overflow = open ? 'hidden' : '';
		};

		button.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
		header.querySelectorAll('#mobile-menu a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
		document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
		window.matchMedia('(min-width: 768px)').addEventListener('change', () => setOpen(false));
	}
</script>
