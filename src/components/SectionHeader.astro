---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';

interface Props {
	index?: string;
	label: string;
	title: string;
	intro?: string;
	link?: { href: string; label: string };
	dark?: boolean;
}

const { index, label, title, intro, link, dark = false } = Astro.props;
---

<div data-reveal class="mb-10 flex flex-col gap-6 md:mb-14 md:flex-row md:items-end md:justify-between">
	<div class="max-w-3xl">
		<p class:list={['flex items-center gap-3 text-xs font-semibold tracking-[0.2em] uppercase', dark ? 'text-accent' : 'text-forest-600']}>
			{index && <span class:list={['rounded-full px-2 py-0.5 tabular-nums', dark ? 'bg-accent text-forest-deep' : 'bg-forest text-accent']}>{index}</span>}
			{label}
		</p>
		<h2 class:list={['mt-4 text-4xl leading-[0.95] font-semibold tracking-tighter text-balance md:text-6xl', dark ? 'text-cream' : 'text-ink']}>
			{title}
		</h2>
		{intro && <p class:list={['mt-4 max-w-xl text-lg', dark ? 'text-cream/60' : 'text-ink/60']}>{intro}</p>}
	</div>
	{link && (
		<a
			href={link.href}
			class:list={[
				'group inline-flex shrink-0 items-center gap-2 self-start rounded-full border px-5 py-3 text-sm font-semibold transition-colors md:self-auto',
				dark
					? 'border-cream/20 text-cream hover:border-accent hover:bg-accent hover:text-forest-deep'
					: 'border-ink/15 text-ink hover:border-forest hover:bg-forest hover:text-cream',
			]}
		>
			{link.label}
			<ArrowUpRight class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
		</a>
	)}
</div>
