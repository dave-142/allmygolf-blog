---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';

interface Props {
	title: string;
	intro?: string;
	link?: { href: string; label: string };
	dark?: boolean;
}

const { title, intro, link, dark = false } = Astro.props;
---

<div data-reveal class="mb-10 flex flex-col gap-6 md:mb-14 md:flex-row md:items-end md:justify-between">
	<div class="max-w-3xl">
		<h2 class:list={['text-4xl leading-[0.95] font-semibold tracking-tighter text-balance md:text-6xl', dark ? 'text-paper' : 'text-ink']}>
			{title}
		</h2>
		{intro && <p class:list={['mt-4 max-w-xl text-lg', dark ? 'text-paper/60' : 'text-ink/60']}>{intro}</p>}
	</div>
	{link && (
		<a
			href={link.href}
			class:list={[
				'group inline-flex shrink-0 items-center gap-2 self-start rounded-full border px-5 py-3 text-sm font-semibold transition-colors md:self-auto',
				dark
					? 'border-paper/20 text-paper hover:border-accent hover:bg-accent hover:text-night'
					: 'border-ink/15 text-ink hover:border-night-800 hover:bg-night-800 hover:text-paper',
			]}
		>
			{link.label}
			<ArrowUpRight class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
		</a>
	)}
</div>
