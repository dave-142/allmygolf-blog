---
// A flag on a green, drawn as a badge
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg viewBox="0 0 32 32" aria-hidden="true" class={className}>
	<circle cx="16" cy="16" r="16" class="fill-accent" />
	<path d="M13 7.5v16" class="stroke-forest-deep" stroke-width="2" stroke-linecap="round" />
	<path d="M13.5 8l8 3.25-8 3.25z" class="fill-forest-deep" />
	<ellipse cx="15" cy="24" rx="6" ry="1.75" class="fill-forest-deep/25" />
</svg>
