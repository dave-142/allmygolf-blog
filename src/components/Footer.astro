---
import ArrowUp from '@lucide/astro/icons/arrow-up';
import Rss from '@lucide/astro/icons/rss';
import LogoMark from '../assets/brand/logo-amg.svg';
import GolferWithBag from '../assets/illustrations/golfer-with-bag.svg';
import { SITE_DESCRIPTION } from '../consts';
import Contours from './Contours.astro';

const year = new Date().getFullYear();

const links = [
	{ href: '/blog/', label: 'Rounds' },
	{ href: '/courses/', label: 'Courses' },
	{ href: '/#map', label: 'Map' },
];
---

<footer class="relative isolate overflow-hidden bg-night text-paper">
	<Contours class="text-accent/7" />

	<div class="mx-auto max-w-7xl px-5 pt-20 pb-10 md:px-8 md:pt-28">
		<div class="grid gap-12 md:grid-cols-[1.5fr_1fr_auto]">
			<div>
				{/* Drawn in black, so its fill is forced to the footer text colour */}
				<LogoMark aria-hidden="true" class="size-20 text-paper md:size-24 [&_path]:fill-current!" />
				<p class="mt-6 max-w-sm text-2xl leading-snug font-light text-balance text-paper/80">{SITE_DESCRIPTION}</p>
			</div>

			<nav aria-label="Footer">
				<p class="mb-4 text-xs font-semibold tracking-[0.2em] text-mist uppercase">Explore</p>
				<ul class="space-y-2 text-lg">
					{links.map((link) => (
						<li>
							<a href={link.href} class="inline-block transition-transform hover:translate-x-1 hover:text-accent">
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>

			<div class="flex items-start gap-3">
				<a
					href="/rss.xml"
					class="grid size-12 place-items-center rounded-full border border-paper/20 transition-colors hover:border-accent hover:bg-accent hover:text-night"
				>
					<Rss class="size-5" aria-hidden="true" />
					<span class="sr-only">RSS feed</span>
				</a>
				<a
					href="#main"
					class="grid size-12 place-items-center rounded-full bg-accent text-night transition-transform hover:-translate-y-1"
				>
					<ArrowUp class="size-5" aria-hidden="true" />
					<span class="sr-only">Back to top</span>
				</a>
			</div>
		</div>

		<!-- A golfer leaning on his bag, standing on a line above the copyright -->
		<div class="mt-16 flex justify-end border-b border-paper/15 pr-2 md:pr-10">
			<GolferWithBag class="-mb-px h-24 w-auto text-paper/85 md:h-32" />
		</div>

		<div class="flex flex-col gap-2 pt-6 text-sm text-paper/50 sm:flex-row sm:justify-between">
			<p>&copy; {year} All My Golf</p>
			<p>Played, walked and written by me.</p>
		</div>
	</div>
</footer>
