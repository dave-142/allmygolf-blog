---
import 'leaflet/dist/leaflet.css';
import 'leaflet.markercluster/dist/MarkerCluster.css';
import { getCollection } from 'astro:content';
import { courseHref } from '../lib/courses';

// One pin per course that has coordinates
const pins = (await getCollection('courses'))
	.filter((course) => course.data.lat != null && course.data.lng != null)
	.map((course) => ({
		lat: course.data.lat!,
		lng: course.data.lng!,
		name: course.data.name,
		href: courseHref(course.id),
	}));
---

<div class="container mx-auto px-6">
    <div class="text-3xl md:text-4xl font-bold pb-6 md:pb-8">Where I've played</div>
    <div
        data-course-map
        data-pins={JSON.stringify(pins)}
        class="isolate h-[40vh]  w-full rounded-2xl border border-olive-400"
    >
    </div>
</div>
<script>
	import L from 'leaflet';
	import 'leaflet.markercluster';

	const CARTO_KEY = 'cb1_59px_1_ec461914e02617913133312d';

	document.querySelectorAll<HTMLDivElement>('[data-course-map]').forEach((el) => {
		const pins: { lat: number; lng: number; name: string; href: string }[] = JSON.parse(
			el.dataset.pins ?? '[]',
		);

		const map = L.map(el, { worldCopyJump: true }).setView([30, 0], 2);

		L.tileLayer(`https://basemaps.cartocdn.com/rastertiles/light_all/{z}/{x}/{y}{r}.png?key=${CARTO_KEY}`, {
			attribution:
				'© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, ' +
				'© <a href="https://carto.com/attribution/">CARTO</a>',
			maxNativeZoom: 18,
			maxZoom: 20,
		}).addTo(map);

		// Nearby courses group into one bubble showing how many, and split apart as you zoom in
		const clusters = L.markerClusterGroup({
			showCoverageOnHover: false,
			maxClusterRadius: 40,
			iconCreateFunction: (cluster) =>
				L.divIcon({
					html: `<span class="grid size-11 place-items-center rounded-full border-2 border-white bg-olive-500 text-sm font-bold text-white shadow">${cluster.getChildCount()}</span>`,
					className: '',
					iconSize: [44, 44],
				}),
		});

		pins.forEach((pin) => {
			const marker = L.marker([pin.lat, pin.lng], {
				title: pin.name,
				alt: `Open the ${pin.name} course page`,
				icon: L.divIcon({
					html: `<span class="block size-5 cursor-pointer rounded-full border-2 border-white bg-olive-500 shadow transition-colors hover:bg-forest"></span>`,
					className: '',
					iconSize: [20, 20],
				}),
			});

			// Course name on hover
			marker.bindTooltip(pin.name, { direction: 'top', offset: [0, -12] });

			// Click goes straight to the course page; Ctrl or Cmd click opens a new tab
			marker.on('click', (event) => {
				const original = event.originalEvent as MouseEvent | undefined;
				if (original && (original.ctrlKey || original.metaKey)) {
					window.open(pin.href, '_blank');
				} else {
					window.location.href = pin.href;
				}
			});

			clusters.addLayer(marker);
		});

		map.addLayer(clusters);

		// Start zoomed to fit all your courses
		if (pins.length > 0) {
			map.fitBounds(clusters.getBounds(), { padding: [40, 40], maxZoom: 8 });
		}
	});
</script>