---
import 'leaflet/dist/leaflet.css';
import 'leaflet.markercluster/dist/MarkerCluster.css';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { courseHref, getCourseSummaries } from '../lib/courses';

// One pin per course that has coordinates. The most recently played one pulses.
const summaries = (await getCourseSummaries()).filter((s) => s.course.data.lat != null && s.course.data.lng != null);

const pins = summaries.map(({ course }, i) => ({
	id: course.id,
	lat: course.data.lat!,
	lng: course.data.lng!,
	name: course.data.name,
	href: courseHref(course.id),
	latest: i === 0,
}));

---

<div class="grid gap-4 lg:grid-cols-[1fr_22rem]">
	<div data-reveal class="relative overflow-hidden rounded-[1.75rem] border border-paper/10 shadow-2xl shadow-black/30">
		<div data-course-map data-pins={JSON.stringify(pins)} class="isolate h-[380px] w-full md:h-[520px]"></div>
		<p class="pointer-events-none absolute bottom-3 left-3 z-500 rounded-full bg-night/80 px-3 py-1 text-xs text-paper/70 backdrop-blur" data-map-hint>
			Click the map to zoom with your mouse wheel
		</p>
	</div>

	<div data-reveal style="--reveal-delay: 120ms" class="flex max-h-[520px] flex-col rounded-[1.75rem] border border-paper/10 bg-night-800/60 p-5 backdrop-blur">
		<p class="flex items-baseline justify-between border-b border-paper/10 pb-4">
			<span class="text-xs font-semibold tracking-[0.2em] text-mist uppercase">The list</span>
			<span class="text-sm text-paper/60"><strong class="text-paper">{summaries.length}</strong> courses</span>
		</p>
		<!-- -mx-3 px-3 makes room for the links' -mx-3 hover backgrounds, so nothing overflows sideways -->
		<div class="-mx-3 overflow-x-hidden overflow-y-auto px-3 [scrollbar-color:var(--color-night-700)_transparent] [scrollbar-width:thin]">
			<ul class="pt-3">
				{summaries.map(({ course, rounds }) => (
					<li>
						<a
							href={courseHref(course.id)}
							data-map-link={course.id}
							class="group flex items-center justify-between gap-3 rounded-xl px-3 py-2.5 -mx-3 transition-colors hover:bg-paper/5"
						>
							<span class="font-medium text-paper group-hover:text-accent">{course.data.name}</span>
							<span class="flex shrink-0 items-center gap-2 text-xs text-paper/50">
								{rounds.length > 0 && <span class="tabular-nums">{rounds.length}&times;</span>}
								<ArrowUpRight class="size-4 opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true" />
							</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</div>
</div>

<script>
	import L from 'leaflet';
	import 'leaflet.markercluster';

	const CARTO_KEY = 'cb1_59px_1_ec461914e02617913133312d';

	type Pin = { id: string; lat: number; lng: number; name: string; href: string; latest: boolean };

	document.querySelectorAll<HTMLDivElement>('[data-course-map]').forEach((el) => {
		const pins: Pin[] = JSON.parse(el.dataset.pins ?? '[]');

		// Wheel zoom stays off until the map is clicked, so scrolling the page never gets stuck on it
		const map = L.map(el, { worldCopyJump: true, scrollWheelZoom: false }).setView([30, 0], 2);
		const hint = el.parentElement?.querySelector<HTMLElement>('[data-map-hint]');
		map.on('click focus', () => {
			map.scrollWheelZoom.enable();
			hint?.remove();
		});
		map.on('mouseout', () => map.scrollWheelZoom.disable());

		L.tileLayer(`https://basemaps.cartocdn.com/rastertiles/dark_all/{z}/{x}/{y}{r}.png?key=${CARTO_KEY}`, {
			attribution:
				'© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors, ' +
				'© <a href="https://carto.com/attribution/">CARTO</a>',
			maxNativeZoom: 18,
			maxZoom: 20,
		}).addTo(map);

		// Nearby courses group into one bubble showing how many, and split apart as you zoom in
		const clusters = L.markerClusterGroup({
			showCoverageOnHover: false,
			maxClusterRadius: 40,
			iconCreateFunction: (cluster) =>
				L.divIcon({
					html: `<span class="grid size-11 place-items-center rounded-full bg-accent text-sm font-bold text-night shadow-[0_0_0_6px_rgb(239_158_75/0.25)]">${cluster.getChildCount()}</span>`,
					className: '',
					iconSize: [44, 44],
				}),
		});

		const markers = new Map<string, L.Marker>();

		pins.forEach((pin) => {
			const pulse = pin.latest
				? '<span class="absolute inset-0 animate-ping-slow rounded-full bg-accent/60"></span>'
				: '';
			const marker = L.marker([pin.lat, pin.lng], {
				title: pin.name,
				alt: `Open the ${pin.name} course page`,
				icon: L.divIcon({
					html: `<span class="relative block size-5 cursor-pointer">${pulse}<span class="absolute inset-0 rounded-full border-[3px] border-night bg-accent shadow-[0_0_0_2px_rgb(239_158_75/0.5)] transition-transform hover:scale-125"></span></span>`,
					className: '',
					iconSize: [20, 20],
				}),
			});

			// Course name on hover
			marker.bindTooltip(pin.name, { direction: 'top', offset: [0, -12] });

			// Click goes straight to the course page; Ctrl or Cmd click opens a new tab
			marker.on('click', (event) => {
				const original = event.originalEvent as MouseEvent | undefined;
				if (original && (original.ctrlKey || original.metaKey)) {
					window.open(pin.href, '_blank');
				} else {
					window.location.href = pin.href;
				}
			});

			markers.set(pin.id, marker);
			clusters.addLayer(marker);
		});

		map.addLayer(clusters);

		// Start zoomed to fit all your courses
		if (pins.length > 0) {
			map.fitBounds(clusters.getBounds(), { padding: [40, 40], maxZoom: 8 });
		}

		// Hovering a course in the list shows its name on the map, when its pin is not inside a cluster
		document.querySelectorAll<HTMLElement>('[data-map-link]').forEach((link) => {
			const marker = markers.get(link.dataset.mapLink ?? '');
			if (!marker) return;
			link.addEventListener('mouseenter', () => {
				if (clusters.getVisibleParent(marker) === marker) marker.openTooltip();
			});
			link.addEventListener('mouseleave', () => marker.closeTooltip());
		});
	});
</script>
