---
// Site styles, included on every page through BaseHead
import '../styles/tailwind.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';
import { Font, getImage } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Pages without an image (home and lists) are shared without one
const { title, description, image } = Astro.props;

// A 1200px copy for social sharing previews, rather than the full original
const shareImage = image && (await getImage({ src: image, width: 1200, format: 'jpg', quality: 70 }));
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!--
	Google Analytics, only after the visitor accepts in the cookie banner. Nothing from Google loads before that.
	is:inline keeps Astro from bundling it, so it runs as early as possible on return visits
-->
<script is:inline>
	window.dataLayer = window.dataLayer || [];
	function gtag() {
		dataLayer.push(arguments);
	}
	window.loadAnalytics = function () {
		if (window.analyticsLoaded) return;
		window.analyticsLoaded = true;
		window['ga-disable-G-PVE1KBPW52'] = false;
		var script = document.createElement('script');
		script.async = true;
		script.src = 'https://www.googletagmanager.com/gtag/js?id=G-PVE1KBPW52';
		document.head.appendChild(script);
		gtag('js', new Date());
		gtag('config', 'G-PVE1KBPW52');
	};
	try {
		if (localStorage.getItem('cookie-consent') === 'granted') window.loadAnalytics();
	} catch (e) {
		// Storage blocked, so treat it as no answer yet
	}
</script>

<Font cssVariable="--font-outfit" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{shareImage && <meta property="og:image" content={new URL(shareImage.src, Astro.url)} />}

<!-- Twitter: a large card when there is an image, otherwise the plain card -->
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
