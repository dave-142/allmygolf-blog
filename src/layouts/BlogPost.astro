---
import { Image, getImage } from 'astro:assets';
import { type CollectionEntry, getEntry } from 'astro:content';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Expand from '@lucide/astro/icons/expand';
import X from '@lucide/astro/icons/x';
import GolferCelebrating from '../assets/illustrations/golfer-celebrating.svg';
import FormattedDate from '../components/FormattedDate.astro';
import PageHero from '../components/PageHero.astro';
import PostGrid from '../components/PostGrid.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Stars from '../components/Stars.astro';
import { bestScore, courseHref, getCourseMap, getPosts, getRounds, postTile } from '../lib/courses';
import Page from './Page.astro';

// The about page uses this layout too, so everything beyond title, description and date is optional
type Props = Partial<CollectionEntry<'blog'>['data']> &
	Pick<CollectionEntry<'blog'>['data'], 'title' | 'description' | 'pubDate'> & {
		id?: string;
		readingTime?: number;
	};

const {
	id,
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	gallery = [],
	course: courseRef,
	score,
	rating,
	verdict,
	tags = [],
	readingTime,
} = Astro.props;

const course = courseRef && (await getEntry(courseRef));
const hero = heroImage ?? gallery[0]?.image;

// Large versions for the lightbox
const photos = await Promise.all(
	gallery.map(async (photo) => ({
		...photo,
		full: (await getImage({ src: photo.image, width: 1600 })).src,
	})),
);

// Three more recent posts to keep reading
const more = id
	? await Promise.all([getPosts(), getCourseMap()]).then(([posts, courses]) =>
			posts
				.filter((p) => p.id !== id)
				.slice(0, 3)
				.map((p) => postTile(p, courses)),
		)
	: [];

// Course best: this round matches your lowest score at the course, and you have played it more than once
const roundsHere = course ? (await getRounds()).filter((r) => r.data.course?.id === course.id) : [];
const courseBest = score != null && roundsHere.length > 1 && score === bestScore(roundsHere);

const scorecard = [
	course && { label: 'Course', value: course.data.name, href: courseHref(course.id) },
	{ label: 'Played', date: pubDate },
	score != null && { label: 'Score', value: String(score), big: true, best: courseBest },
	course?.data.par != null && score != null && {
		label: 'To par',
		value: `${score - course.data.par > 0 ? '+' : ''}${score - course.data.par}`,
		big: true,
	},
	rating != null && { label: 'Rating', rating },
].filter(Boolean) as { label: string; value?: string; href?: string; date?: Date; big?: boolean; rating?: number; best?: boolean }[];
---

<Page title={title} description={description} image={hero}>
	<PageHero eyebrow={course?.data.name} title={title} image={hero} tall={!!hero}>
		<div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-paper/70">
			<FormattedDate date={pubDate} />
			{readingTime && (
				<>
					<span aria-hidden="true" class="size-1 rounded-full bg-accent"></span>
					<span>{readingTime} min read</span>
				</>
			)}
			{updatedDate && (
				<>
					<span aria-hidden="true" class="size-1 rounded-full bg-accent"></span>
					<span>Updated <FormattedDate date={updatedDate} /></span>
				</>
			)}
		</div>
	</PageHero>

	<article class="relative">
		{scorecard.length > 1 && (
			<div class="mx-auto -mt-10 max-w-5xl px-5 md:-mt-14 md:px-8">
				<dl
					data-reveal
					class="grid grid-cols-2 gap-px overflow-hidden rounded-[1.75rem] bg-ink/10 shadow-[0_30px_60px_-30px_rgb(28_35_38/0.45)] ring-1 ring-ink/5 md:grid-flow-col md:auto-cols-fr md:grid-cols-none"
				>
					{scorecard.map((cell, i) => (
						<div
							class:list={[
								'flex flex-col justify-between gap-2 bg-white p-5 md:p-6',
								i === 0 && scorecard.length % 2 === 1 && 'col-span-2 md:col-span-1',
							]}
						>
							<dt class="text-[0.65rem] font-semibold tracking-[0.2em] text-ink/40 uppercase">{cell.label}</dt>
							<dd class:list={[cell.big ? 'text-4xl font-extralight tracking-tighter tabular-nums' : 'text-lg leading-tight font-semibold']}>
								{cell.href ? (
									<a href={cell.href} class="group inline-flex items-start gap-1 hover:text-slate">
										{cell.value}
										<ArrowUpRight class="size-4 shrink-0 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
									</a>
								) : cell.date ? (
									<FormattedDate date={cell.date} />
								) : cell.rating != null ? (
									<Stars rating={cell.rating} class="text-xl text-slate" />
								) : cell.best ? (
									<span class="flex items-end justify-between gap-3">
										{cell.value}
										<GolferCelebrating class="-mb-1 h-14 w-auto text-ink" />
									</span>
								) : (
									cell.value
								)}
							</dd>
							{cell.best && (
								<p class="-mt-1 text-[0.65rem] font-semibold tracking-[0.2em] text-accent-dark uppercase">Course best</p>
							)}
						</div>
					))}
				</dl>
			</div>
		)}

		<div class="mx-auto max-w-3xl px-5 pt-14 pb-16 md:px-8 md:pt-20">
			{verdict && (
				<figure data-reveal class="relative mb-14 pl-8 md:pl-12">
					<span aria-hidden="true" class="absolute -top-3 left-0 font-serif text-8xl leading-none text-accent-dark md:-top-5 md:text-9xl">&ldquo;</span>
					<blockquote class="text-3xl leading-tight font-medium tracking-tight text-balance md:text-4xl">{verdict}</blockquote>
					<figcaption class="mt-4 text-xs font-semibold tracking-[0.2em] text-slate uppercase">The verdict</figcaption>
				</figure>
			)}

			<p class="mb-10 text-xl leading-relaxed text-ink/70 md:text-2xl">{description}</p>

			<div
				class="prose prose-lg max-w-none prose-neutral prose-headings:font-semibold prose-headings:tracking-tight prose-h2:mt-14 prose-h2:text-3xl prose-a:text-slate prose-a:decoration-accent-dark prose-a:decoration-2 prose-a:underline-offset-4 prose-blockquote:border-l-4 prose-blockquote:border-accent-dark prose-blockquote:font-medium prose-blockquote:text-ink prose-blockquote:not-italic prose-img:rounded-2xl prose-li:marker:text-slate"
			>
				<slot />
			</div>

			{tags.length > 0 && (
				<ul class="mt-12 flex flex-wrap gap-2 border-t border-ink/10 pt-8">
					{tags.map((tag) => (
						<li class="rounded-full bg-panel px-4 py-1.5 text-sm font-medium text-night-800">#{tag}</li>
					))}
				</ul>
			)}
		</div>

		{photos.length > 0 && (
			<section class="mx-auto max-w-7xl px-5 pb-20 md:px-8">
				<SectionHeader label="Gallery" title="From the course" />
				<div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
					{photos.map((photo, i) => (
						<button
							type="button"
							data-reveal
							data-lightbox-open={photo.full}
							data-caption={photo.caption ?? ''}
							style={`--reveal-delay: ${(i % 3) * 80}ms`}
							class="group relative mb-4 block w-full cursor-zoom-in break-inside-avoid overflow-hidden rounded-3xl bg-night-800"
						>
							<Image
								src={photo.image}
								alt={photo.caption ?? ''}
								widths={[600, 1200]}
								sizes="(min-width: 1024px) 410px, (min-width: 640px) 50vw, 100vw"
								class:list={[
									'w-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-105',
									i % 3 === 0 ? 'aspect-4/5' : 'aspect-4/3',
								]}
							/>
							<span class="absolute top-3 right-3 grid size-10 place-items-center rounded-full bg-night/60 text-paper opacity-0 backdrop-blur transition-opacity group-hover:opacity-100">
								<Expand class="size-4" aria-hidden="true" />
							</span>
							{photo.caption && (
								<span class="absolute inset-x-0 bottom-0 bg-linear-to-t from-night/90 to-transparent p-4 pt-10 text-left text-sm text-paper">
									{photo.caption}
								</span>
							)}
							<span class="sr-only">Open photo {i + 1} full size</span>
						</button>
					))}
				</div>
			</section>
		)}
	</article>

	{more.length > 0 && (
		<section class="bg-panel/60 py-20 md:py-24">
			<div class="mx-auto max-w-7xl px-5 md:px-8">
				<SectionHeader label="Keep reading" title="More rounds" link={{ href: '/blog/', label: 'All rounds' }} />
				<PostGrid tiles={more.map((t) => ({ ...t, featured: false }))} columns={3} />
			</div>
		</section>
	)}

	{id && (
		<div class="mx-auto max-w-7xl px-5 py-10 md:px-8">
			<a href="/blog/" class="group inline-flex items-center gap-2 text-sm font-semibold text-slate">
				<ArrowLeft class="size-4 transition-transform group-hover:-translate-x-1" aria-hidden="true" />
				Back to all rounds
			</a>
		</div>
	)}

	{photos.length > 0 && (
		<dialog
			data-lightbox
			class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-night/95 backdrop:backdrop-blur-sm"
		>
			<figure class="flex h-svh w-screen flex-col items-center justify-center gap-4 p-4 md:p-10">
				<img data-lightbox-img alt="" class="max-h-[85svh] max-w-full rounded-2xl object-contain shadow-2xl" />
				<figcaption data-lightbox-caption class="text-sm text-paper/70"></figcaption>
			</figure>
			<form method="dialog">
				<button class="fixed top-4 right-4 grid size-12 place-items-center rounded-full bg-accent text-night transition-transform hover:rotate-90">
					<X class="size-5" aria-hidden="true" />
					<span class="sr-only">Close</span>
				</button>
			</form>
		</dialog>
	)}
</Page>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
	const img = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
	const caption = dialog?.querySelector<HTMLElement>('[data-lightbox-caption]');

	if (dialog && img && caption) {
		document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]').forEach((button) =>
			button.addEventListener('click', () => {
				img.src = button.dataset.lightboxOpen ?? '';
				img.alt = button.dataset.caption ?? '';
				caption.textContent = button.dataset.caption ?? '';
				dialog.showModal();
			}),
		);
		// Clicking the dark area around the photo closes it
		dialog.addEventListener('click', (e) => {
			if (e.target !== img) dialog.close();
		});
	}
</script>
