---
import { Image } from 'astro:assets';
import { type CollectionEntry, getEntry } from 'astro:content';
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Expand from '@lucide/astro/icons/expand';
import X from '@lucide/astro/icons/x';
import FormattedDate from '../components/FormattedDate.astro';
import PageHero from '../components/PageHero.astro';
import PostGrid from '../components/PostGrid.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Stars from '../components/Stars.astro';
import { bestScore, courseHref, getCourseMap, getPosts, getRounds, postTile } from '../lib/courses';
import Page from './Page.astro';

// The about page uses this layout too, so everything beyond title, description and date is optional
type Props = Partial<CollectionEntry<'blog'>['data']> &
	Pick<CollectionEntry<'blog'>['data'], 'title' | 'description' | 'pubDate'> & {
		id?: string;
		// False when a post has nothing under the frontmatter. The about page leaves it out
		hasBody?: boolean;
	};

const {
	id,
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	gallery = [],
	course: courseRef,
	score,
	rating,
	verdict,
	type,
	roundNotes,
	tags = [],
	hasBody = true,
} = Astro.props;

const course = courseRef && (await getEntry(courseRef));
const hero = heroImage ?? gallery[0]?.image;

const photos = gallery;

// Three more recent posts to keep reading
const more = id
	? await Promise.all([getPosts(), getCourseMap()]).then(([posts, courses]) =>
			posts
				.filter((p) => p.id !== id)
				.slice(0, 3)
				.map((p) => postTile(p, courses)),
		)
	: [];

// Course best: this round matches your lowest score at the course, and you have played it more than once
const roundsHere = course ? (await getRounds()).filter((r) => r.data.course?.id === course.id) : [];
const courseBest = score != null && roundsHere.length > 1 && score === bestScore(roundsHere);

// Score against par, e.g. +9, E or -2
const par = course?.data.par;
const yardage = course?.data.yardage;
const toPar = par && score != null ? (score === par ? 'E' : score > par ? `+${score - par}` : `${score - par}`) : undefined;

// Imported rounds use the course id as their description, and some repeat the title. Neither is worth showing
const showDescription = description && description !== course?.id && description.trim().toLowerCase() !== title.trim().toLowerCase();

// Round notes, only on rounds. The plan and Did it work? sit at the top of the post, the rest in the Round notes section.
// Each answered question becomes one item, so unanswered ones never show
const notes = type === 'round' ? roundNotes : undefined;
// 1st, 2nd, 3rd, 4th, 11th, 12th, 13th, 21st
const ordinal = (n: number) => {
	const teen = n % 100 >= 11 && n % 100 <= 13;
	return `${n}${teen ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] ?? 'th'}`;
};
const hole = notes?.holeWorthKnowing;
const noteItems = [
	{ label: 'What went well', text: notes?.wentWell },
	{ label: "What didn't", text: notes?.wentBadly },
	{ label: 'Next time', text: notes?.nextTime },
	{ label: 'The hole worth knowing', heading: hole?.hole ? `The ${ordinal(hole.hole)}` : undefined, text: hole?.note },
	{ label: 'Conditions', text: notes?.conditions },
].filter((item) => item.heading || item.text);
const planItems = [
	{ label: 'The plan', text: notes?.purpose },
	{ label: 'Did it work?', text: notes?.didItWork },
].filter((item) => item.text);

const prose =
	'prose prose-lg max-w-none prose-neutral prose-headings:font-semibold prose-headings:tracking-tight prose-h2:mt-12 prose-h2:text-3xl prose-a:text-slate prose-a:decoration-accent-dark prose-a:decoration-2 prose-a:underline-offset-4 prose-blockquote:border-l-4 prose-blockquote:border-accent-dark prose-blockquote:font-medium prose-blockquote:text-ink prose-blockquote:not-italic prose-img:rounded-2xl prose-li:marker:text-slate [&>:first-child]:mt-0';
---

<Page title={title} description={description} image={hero}>
	<PageHero title={title} intro={showDescription ? description : undefined} image={hero} tall={!course && !!hero}>
		{(!course || updatedDate) && (
			<ul class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-paper/70 [&>li+li]:before:mr-4 [&>li+li]:before:inline-block [&>li+li]:before:size-1 [&>li+li]:before:rounded-full [&>li+li]:before:bg-accent [&>li+li]:before:align-middle [&>li+li]:before:content-['']">
				{!course && <li><FormattedDate date={pubDate} /></li>}
				{updatedDate && <li>Updated <FormattedDate date={updatedDate} /></li>}
			</ul>
		)}
	</PageHero>

	<article class="relative">
		<div
			class:list={[
				'mx-auto px-5 pt-10 pb-16 md:px-8 md:pt-16 md:pb-20',
				course ? 'grid max-w-6xl gap-10 lg:grid-cols-[20rem_minmax(0,1fr)] lg:gap-16' : 'max-w-3xl',
			]}
		>
			{id && (
				<nav
					aria-label="Post"
					class:list={['flex flex-wrap items-center justify-between gap-3 border-b border-ink/10 pb-6', course ? 'lg:col-span-2' : 'mb-10']}
				>
					<ul class="flex flex-wrap items-center gap-2">
						<li>
							<a
								href="/blog/"
								class="group inline-flex items-center gap-2 rounded-full border border-ink/15 px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-night-800 hover:bg-night-800 hover:text-paper"
							>
								<ArrowLeft class="size-4 transition-transform group-hover:-translate-x-0.5" aria-hidden="true" />
								All rounds
							</a>
						</li>
					</ul>
					{/* Room on the right for more navigation later, e.g. previous and next round */}
				</nav>
			)}

			{course && (
				<aside data-reveal class="self-start rounded-[1.75rem] bg-night p-6 text-paper shadow-[0_30px_60px_-30px_rgb(28_35_38/0.6)]">
					<p class="font-semibold tracking-[0.2em] text-paper/60 uppercase"><FormattedDate date={pubDate} /></p>

					<a href={courseHref(course.id)} class="group mt-4 flex items-start justify-between gap-3 text-2xl leading-tight font-semibold tracking-tight text-balance hover:text-accent">
						{course.data.name}
						<ArrowUpRight class="mt-0.5 size-5 shrink-0 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
					</a>

					<div class="mt-5 flex items-stretch justify-between gap-4 border-t border-paper/15 pt-5">
						{score != null ? (
							<div class="flex flex-col justify-between">
								<p class="font-semibold tracking-widest text-paper/60 uppercase">Score</p>
								<p class="mt-2">
									<span class="text-6xl leading-none font-bold text-accent tabular-nums">{score}</span>
									{toPar && <span class="ml-2 text-xl font-medium text-paper/60 tabular-nums">{toPar}</span>}
								</p>
							</div>
						) : (
							<span></span>
						)}
						<dl class="flex gap-5 text-right [&>div]:flex [&>div]:flex-col [&>div]:justify-between">
							{par ? (
								<div>
									<dt class="font-semibold tracking-widest text-paper/60 uppercase">Par</dt>
									<dd class="mt-2 text-5xl leading-none font-semibold tabular-nums">{par}</dd>
								</div>
							) : null}
						</dl>
					</div>

					{yardage ? (
						<dl class="mt-5 flex items-baseline justify-between gap-4 border-t border-paper/15 pt-5">
							<dt class="font-semibold tracking-widest text-paper/60 uppercase">Yards</dt>
							<dd class="text-lg leading-none font-semibold tabular-nums">{yardage.toLocaleString('en-GB')}</dd>
						</dl>
					) : null}

					{courseBest && (
						<p class="mt-4 inline-block rounded-full bg-accent px-3 py-1 text-[0.65rem] font-semibold tracking-wider text-night uppercase">Course best</p>
					)}

					{(rating != null || verdict) && (
						<div class="mt-5 border-t border-paper/15 pt-5">
							{rating != null && <Stars rating={rating} class="text-lg text-accent" />}
							{verdict && <p class="mt-3 font-serif text-xl leading-snug text-paper/90 italic">&ldquo;{verdict}&rdquo;</p>}
						</div>
					)}
				</aside>
			)}

			<div class="flex flex-col gap-12">
				{planItems.length > 0 && (
					<dl data-reveal class="grid gap-x-10 gap-y-6 md:grid-cols-2">
						{planItems.map((item) => (
							<div>
								<dt class="text-xs font-semibold tracking-[0.2em] text-slate uppercase">{item.label}</dt>
								<dd class="mt-2 text-2xl leading-snug font-medium tracking-tight text-balance whitespace-pre-line">{item.text}</dd>
							</div>
						))}
					</dl>
				)}

				{hasBody && (
					<div class={prose}>
						<slot />
					</div>
				)}

				{noteItems.length > 0 && (
					<section aria-labelledby="round-notes" data-reveal>
						<h2 id="round-notes" class="text-3xl font-semibold tracking-tight">Round notes</h2>
						<dl class="mt-6 grid gap-x-10 md:grid-cols-2">
							{noteItems.map((item) => (
								<div class="border-t border-ink/10 py-5">
									<dt class="text-xs font-semibold tracking-[0.2em] text-slate uppercase">{item.label}</dt>
									{item.heading && <dd class="mt-2 text-2xl font-semibold tracking-tight">{item.heading}</dd>}
									{item.text && <dd class="mt-2 text-lg leading-relaxed whitespace-pre-line text-ink/80">{item.text}</dd>}
								</div>
							))}
						</dl>
					</section>
				)}

				{tags.length > 0 && (
					<ul class="flex flex-wrap gap-2 border-t border-ink/10 pt-8">
						{tags.map((tag) => (
							<li class="rounded-full bg-panel px-4 py-1.5 text-sm font-medium text-night-800">#{tag}</li>
						))}
					</ul>
				)}
			</div>
		</div>

		{photos.length > 0 && (
			<section class="mx-auto max-w-7xl px-5 pb-20 md:px-8">
				<SectionHeader label="Gallery" title="From the course" />
				<div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
					{photos.map((photo, i) => (
						<button
							type="button"
							data-reveal
							data-lightbox-open
							data-caption={photo.caption ?? ''}
							style={`--reveal-delay: ${(i % 3) * 80}ms`}
							class="group relative mb-4 block w-full cursor-zoom-in break-inside-avoid overflow-hidden rounded-3xl bg-night-800"
						>
							<Image
								src={photo.image}
								alt={photo.caption ?? ''}
								widths={[600, 1200]}
								quality={70}
								sizes="(min-width: 1024px) 410px, (min-width: 640px) 50vw, 100vw"
								class:list={[
									'w-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-105',
									i % 3 === 0 ? 'aspect-4/5' : 'aspect-4/3',
								]}
							/>
							<span class="absolute top-3 right-3 grid size-10 place-items-center rounded-full bg-night/60 text-paper opacity-0 backdrop-blur transition-opacity group-hover:opacity-100">
								<Expand class="size-4" aria-hidden="true" />
							</span>
							{photo.caption && (
								<span class="absolute inset-x-0 bottom-0 bg-linear-to-t from-night/90 to-transparent p-4 pt-10 text-left text-sm text-paper">
									{photo.caption}
								</span>
							)}
							<span class="sr-only">Open photo {i + 1} full size</span>
						</button>
					))}
				</div>
			</section>
		)}
	</article>

	{more.length > 0 && (
		<section class="bg-panel/60 py-20 md:py-24">
			<div class="mx-auto max-w-7xl px-5 md:px-8">
				<SectionHeader label="Keep reading" title="More rounds" link={{ href: '/blog/', label: 'All rounds' }} />
				<PostGrid tiles={more.map((t) => ({ ...t, featured: false }))} columns={3} />
			</div>
		</section>
	)}


	{photos.length > 0 && (
		<dialog
			data-lightbox
			class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-night/95 backdrop:backdrop-blur-sm"
		>
			<figure class="flex h-svh w-screen flex-col items-center justify-center gap-4 p-4 md:p-10">
				<img data-lightbox-img alt="" class="max-h-[85svh] max-w-full rounded-2xl object-contain shadow-2xl" />
				<figcaption data-lightbox-caption class="text-sm text-paper/70"></figcaption>
			</figure>
			<form method="dialog">
				<button class="fixed top-4 right-4 grid size-12 place-items-center rounded-full bg-accent text-night transition-transform hover:rotate-90">
					<X class="size-5" aria-hidden="true" />
					<span class="sr-only">Close</span>
				</button>
			</form>
		</dialog>
	)}
</Page>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
	const img = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
	const caption = dialog?.querySelector<HTMLElement>('[data-lightbox-caption]');

	if (dialog && img && caption) {
		document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]').forEach((button) =>
			button.addEventListener('click', () => {
				// Show the largest version the gallery photo already has, so no extra copy is needed
				const thumb = button.querySelector('img');
				const largest = (thumb?.srcset ?? '')
					.split(',')
					.map((entry) => entry.trim().split(/\s+/))
					.filter(([url]) => url)
					.sort((a, b) => parseInt(b[1] ?? '0') - parseInt(a[1] ?? '0'))[0]?.[0];
				img.src = largest ?? thumb?.currentSrc ?? '';
				img.alt = button.dataset.caption ?? '';
				caption.textContent = button.dataset.caption ?? '';
				dialog.showModal();
			}),
		);
		// Clicking the dark area around the photo closes it
		dialog.addEventListener('click', (e) => {
			if (e.target !== img) dialog.close();
		});
	}
</script>
